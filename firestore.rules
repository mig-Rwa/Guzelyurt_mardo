rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Public read access for menu, specials, testimonials, gallery
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if false; // Admin only via admin SDK
    }
    
    match /specials/{specialId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if false;
    }
    
    match /galleryItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Reservations - authenticated users can create, read own
    match /reservations/{reservationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    // Orders - authenticated users can create, read own
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
    }
    
    // Newsletter - anyone can subscribe
    match /newsletterSubscribers/{email} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    
    // User profiles - users can read/write their own
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Loyalty points - users can read their own
    match /loyaltyPoints/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Only via cloud functions
    }
    
    // Daily summaries - admin only
    match /dailySummaries/{summaryId} {
      allow read, write: if false;
    }
  }
}
